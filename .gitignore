#Files under data/ can be generated via scripts
#Ignore everything in the data folder by default
data/*

#But allow the entire images folder (! used with folders/files to include explicitly)
!data/images/

#Allow the models folder
!data/models/

# Ignore files inside processed
data/processed/*

# But allow the processed folders used by the app
!data/processed/interactions_final.csv
!data/processed/products_final.csv
!data/processed/users_clean.csv

#Ignores the internal python generated files
__pycache__/

#Ignore .env file
.env